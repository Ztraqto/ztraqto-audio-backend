{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ztraqto/ztraqto-audio-backend/schema/product.schema.json",
  "title": "Ztraqto Audio 製品ページ（products/<URL名>.json）",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "$defs": {
    "text": { "type": "string" },
    "image": {
      "type": "string",
      "description": "images/ から始まるリポジトリ内のパス（例: images/athena-qx/hero.webp）か、raw.githubusercontent.com / cdn.jsdelivr.net / booth.pximg.net の https URL。PNG・JPEG・WebP・AVIF・GIF（SVG は不可）",
      "pattern": "^(images/[A-Za-z0-9._/-]+\\.(png|jpe?g|webp|avif|gif)|https://(raw\\.githubusercontent\\.com|cdn\\.jsdelivr\\.net|booth\\.pximg\\.net)/.+)$"
    },
    "link": { "type": "string", "description": "https:// の booth.pm / ztraqto.com（とそのサブドメイン）のURL。空ならリンクなし", "pattern": "^(|https://.+)$", "maxLength": 500 },
    "time": {
      "type": ["string", "null"],
      "description": "\"2026-12-01T00:00:00+09:00\"。時差を書かなければ日本時間（\"2026-12-01\" や \"2026-12-01T18:00\" も可）"
    },
    "visual": { "enum": ["eq", "wave", "spectrum", "orbit"], "description": "画像がないときに描く動く絵" },
    "section": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["statement", "feature", "highlights", "stats", "gallery", "specs", "quote", "video", "cta"],
          "description": "statement=大見出し（スクロールで文字が光る） / feature=特徴（画像か動く絵＋説明） / highlights=ポイント / stats=数字（カウントアップ） / gallery=ギャラリー（横スクロール） / specs=仕様表 / quote=引用 / video=YouTube / cta=購入の呼びかけ"
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "statement" } } }, "then": { "properties": { "type": true, "heading": { "type": "string", "maxLength": 120 }, "body": { "type": "string", "maxLength": 600 } }, "required": ["heading"], "additionalProperties": false } },
        { "if": { "properties": { "type": { "const": "feature" } } }, "then": { "properties": { "type": true, "eyebrow": { "type": "string", "maxLength": 40 }, "heading": { "type": "string", "maxLength": 120 }, "body": { "type": "string", "maxLength": 1200 }, "image": { "$ref": "#/$defs/image" }, "visual": { "$ref": "#/$defs/visual" }, "align": { "enum": ["left", "right"] } }, "required": ["heading"], "additionalProperties": false } },
        { "if": { "properties": { "type": { "const": "highlights" } } }, "then": { "properties": { "type": true, "heading": { "type": "string", "maxLength": 120 }, "items": { "type": "array", "minItems": 1, "maxItems": 9, "items": { "type": "object", "properties": { "title": { "type": "string", "maxLength": 60 }, "body": { "type": "string", "maxLength": 300 } }, "required": ["title"], "additionalProperties": false } } }, "required": ["items"], "additionalProperties": false } },
        { "if": { "properties": { "type": { "const": "stats" } } }, "then": { "properties": { "type": true, "heading": { "type": "string", "maxLength": 120 }, "items": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "object", "properties": { "value": { "type": "string", "maxLength": 12 }, "unit": { "type": "string", "maxLength": 16 }, "label": { "type": "string", "maxLength": 60 } }, "required": ["value"], "additionalProperties": false } } }, "required": ["items"], "additionalProperties": false } },
        { "if": { "properties": { "type": { "const": "gallery" } } }, "then": { "properties": { "type": true, "heading": { "type": "string", "maxLength": 120 }, "images": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/image" } } }, "required": ["images"], "additionalProperties": false } },
        { "if": { "properties": { "type": { "const": "specs" } } }, "then": { "properties": { "type": true, "heading": { "type": "string", "maxLength": 120 }, "rows": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "type": "object", "properties": { "label": { "type": "string", "maxLength": 40 }, "value": { "type": "string", "maxLength": 200 } }, "required": ["label", "value"], "additionalProperties": false } } }, "required": ["rows"], "additionalProperties": false } },
        { "if": { "properties": { "type": { "const": "quote" } } }, "then": { "properties": { "type": true, "text": { "type": "string", "maxLength": 400 }, "author": { "type": "string", "maxLength": 80 } }, "required": ["text"], "additionalProperties": false } },
        { "if": { "properties": { "type": { "const": "video" } } }, "then": { "properties": { "type": true, "heading": { "type": "string", "maxLength": 120 }, "youtube": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$", "description": "YouTube の動画ID（11文字）" } }, "required": ["youtube"], "additionalProperties": false } },
        { "if": { "properties": { "type": { "const": "cta" } } }, "then": { "properties": { "type": true, "heading": { "type": "string", "maxLength": 120 }, "body": { "type": "string", "maxLength": 400 } }, "required": ["heading"], "additionalProperties": false } }
      ]
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "status": { "enum": ["published", "hidden", "draft"], "default": "published", "description": "published=一覧に出す / hidden=URLを知っている人だけ / draft=出さない（ZCC のプレビューだけ）" },
    "name": { "type": "string", "minLength": 1, "maxLength": 60, "description": "製品名" },
    "tagline": { "type": "string", "maxLength": 120, "description": "キャッチコピー" },
    "summary": { "type": "string", "maxLength": 600, "description": "概要" },
    "category": { "type": "string", "description": "categories.json の slug（例: eq）" },
    "licenseProductId": { "type": ["string", "null"], "pattern": "^[0-9A-Z]{8}$", "description": "License の製品ID（例: ZAATQ001）。持っている人に「所有しています」を出す" },
    "tags": { "type": "array", "uniqueItems": true, "items": { "enum": ["NEW", "BETA", "UPDATE", "COMING_SOON", "LIMITED"] }, "description": "手で付けるタグ。「セール」と「無料」は価格から自動で付く" },
    "price": { "type": ["integer", "null"], "minimum": 0, "maximum": 10000000, "description": "通常価格（円）。0 なら「無料」タグが付く" },
    "sale": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "price": { "type": "integer", "minimum": 0, "description": "セール価格（円）。通常価格より安く" },
        "startsAt": { "$ref": "#/$defs/time" },
        "endsAt": { "$ref": "#/$defs/time", "description": "書くと終了までのカウントダウンが出る" },
        "label": { "type": "string", "maxLength": 40, "description": "セール名（例: 発売記念セール）" }
      }
    },
    "buyUrl": { "$ref": "#/$defs/link", "description": "購入リンク（Booth）。公開（published）には buyUrl か COMING_SOON タグが必要" },
    "demoUrl": { "$ref": "#/$defs/link" },
    "manualUrl": { "$ref": "#/$defs/link" },
    "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "description": "製品の色（例: #9B7BFF）" },
    "visual": { "$ref": "#/$defs/visual" },
    "hero": { "$ref": "#/$defs/image", "description": "メイン画像" },
    "icon": { "$ref": "#/$defs/image", "description": "アイコン（一覧のカードと購入欄）" },
    "formats": { "type": "array", "uniqueItems": true, "items": { "enum": ["VST3", "AU", "CLAP", "AAX", "LV2", "Standalone"] } },
    "platforms": { "type": "array", "uniqueItems": true, "items": { "enum": ["Windows", "macOS", "Linux"] } },
    "version": { "type": "string", "maxLength": 20 },
    "releaseDate": { "type": "string", "pattern": "^(|\\d{4}-\\d{2}-\\d{2})$" },
    "featured": { "type": "boolean", "description": "true の最初の製品がトップページの大きな見出しになる" },
    "order": { "type": "integer", "description": "並び順（小さいほど先）" },
    "seoDescription": { "type": "string", "maxLength": 200, "description": "検索結果に出る説明" },
    "sections": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/section" }, "description": "ページの中身。上から順に並ぶ" }
  }
}
